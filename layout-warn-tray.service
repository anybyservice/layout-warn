[Unit]
Description=Layout-warn tray toggle (вкл/выкл сторожа)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/bin/layout-warn-tray.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
